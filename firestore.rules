rules_version = '2';

// Expent mutual-debt sync — Firestore security rules.
// Deploy via Firebase console -> Firestore Database -> Rules, or:
//   firebase deploy --only firestore:rules
//
// A debt document is only readable/writable by its participants. Payment
// documents carry their own copy of `participants` so the rules stay
// self-contained: rules that call get() cannot guard queries, which would
// break the app's payment listeners.
service cloud.firestore {
  match /databases/{database}/documents {

    match /debts/{debtId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.participants;
      allow update, delete: if request.auth != null && request.auth.uid in resource.data.participants;
    }

    match /debt_payments/{paymentId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.participants;
      allow create, update, delete: if request.auth != null && request.auth.uid in request.resource.data.participants;
    }
  }
}
