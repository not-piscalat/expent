rules_version = '2';

// Expent mutual-debt sync — Firestore security rules.
// Deploy via Firebase console -> Firestore Database -> Rules, or:
//   firebase deploy --only firestore:rules
//
// A debt document is only readable/writable by its participants. Payment
// documents carry their own copy of `participants` so the rules stay
// self-contained: rules that call get() cannot guard queries, which would
// break the app's payment listeners.
//
// Sharing: the creator mints a 6-character code and stores it on the debt doc.
// The code is the invitation — anyone signed in can look a debt up BY its code
// (list), but cannot enumerate debts (queries without a code filter can still
// match code-less docs, so Firestore denies them). Joining is an update that
// adds the joiner to `participants`; until they are in the list, the only
// fields they may touch are `participants` and `otherParticipantId`.
service cloud.firestore {
  match /databases/{database}/documents {

    match /debts/{debtId} {
      allow get: if request.auth != null && request.auth.uid in resource.data.participants;
      allow list: if request.auth != null && (
        request.auth.uid in resource.data.participants ||
        resource.data.shareCode != null
      );
      allow create: if request.auth != null && request.auth.uid in request.resource.data.participants;
      allow update: if request.auth != null && (
        request.auth.uid in resource.data.participants ||
        (request.auth.uid in request.resource.data.participants &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(["participants", "otherParticipantId"]))
      );
      allow delete: if request.auth != null && request.auth.uid in resource.data.participants;
    }

    match /debt_payments/{paymentId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.participants;
      allow create, update: if request.auth != null && request.auth.uid in request.resource.data.participants;
      // Deletes must check the EXISTING doc: request.resource (the would-be new
      // document) is undefined for a delete, so any delete-only rule keyed on it
      // silently denies every payment removal.
      allow delete: if request.auth != null && request.auth.uid in resource.data.participants;
    }
  }
}
